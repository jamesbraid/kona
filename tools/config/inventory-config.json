{
  "family": "InfiniteReality (KONA)",
  "siblings": {"odsy": "../odsy", "crime": "../crime"},
  "review_required": ["evidence/routines/t1-*.md", "evidence/routines/t2-*.md"],
  "docs": {
    "prose": [
      "platforms/ir/architecture.md",
      "software/opengl/capability-trees.md",
      "formats/token/command-table.md",
      "evidence/coverage.md",
      "software/diags/data-files.md",
      "devices/dg/README.md",
      "software/kernel/diag-messages.md",
      "software/video/display-file-format.md",
      "software/video/display-formats.md",
      "devices/ge/ge-arm-tokens.md",
      "devices/ge/ge-routed-tokens.md",
      "devices/ge/ge-shadow-words.md",
      "devices/ge/README.md",
      "software/opengl/gl-command-map.md",
      "devices/hip/README.md",
      "evidence/hw-explanations-kona-p1.md",
      "software/userland/install-tools.md",
      "evidence/instruction-readings-*.md",
      "software/irisgl/irisgl.md",
      "software/diags/irsaudit.md",
      "software/kernel/kernel-functions.md",
      "software/kernel/kernel-objects.md",
      "software/kernel/kernel.md",
      "software/xsgi/kona-ddx.md",
      "software/xsgi/kona-so-functions.md",
      "software/diags/kpm.md",
      "software/irisgl/libfm.md",
      "software/opengl/libgl.md",
      "software/opengl/libglcore-driver-builds.md",
      "software/opengl/libglcore-driver-functions.md",
      "software/opengl/libglcore-functions.md",
      "software/opengl/libglcore-get-functions.md",
      "software/opengl/libglcore-list-records.md",
      "software/opengl/libglcore.md",
      "software/opengl/libraries.md",
      "questions/README.md",
      "software/opengl/opengl.md",
      "software/userland/pipe-tool-functions.md",
      "references/documents/published-sources.md",
      "devices/rm/README.md",
      "software/opengl/sample-implementation.md",
      "software/userland/setup-tool-functions.md",
      "software/userland/setup-tools.md",
      "software/userland/shared-libraries.md",
      "platforms/ir/textport.md",
      "evidence/tooling-bakeoff.md",
      "evidence/tooling.md",
      "software/xsgi/x-server-glx.md",
      "devices/xg/README.md",
      "software/xsgi/xserver.md",
      "evidence/routines/*.md",
      "ucode/*.md",
      "README.md"
    ],
    "headers": [
      "*.h",
      "devices/*/*.h",
      "*/include/*.h"
    ],
    "tables": [
      "*/*.tsv",
      "software/*/*.tsv"
    ],
    "index": [
      "AGENTS.md",
      "README.md",
      "evidence/irix-files.md",
      "evidence/coverage.md",
      "questions/README.md"
    ],
    "dumps": [
      "ucode/arm1_symbols.tsv",
      "ucode/icu_map.tsv"
    ],
    "skip": [
      "evidence/inventory/*",
      "diags/kpm/*"
    ]
  },
  "prepare": [
    [
      "python3",
      "retools/tools/kona/extract_kpm_tables.py",
      "root/usr/gfx/KONA/bin/kpm",
      "{tmp}"
    ],
    [
      "python3",
      "retools/tools/kona/arm1_disasm.py",
      "root/usr/gfx/ucode/KONA/arm1.u",
      "{tmp}"
    ]
  ],
  "binaries": [
    {
      "group": "kernel",
      "role": "board-kernel",
      "paths": [
        "usr/cpu/sysgen/IP27boot/kona.a",
        "usr/cpu/sysgen/IP35boot/kona.a"
      ]
    },
    {
      "group": "kernel-shared",
      "role": "shared-kernel",
      "paths": [
        "usr/cpu/sysgen/IP27boot/gfx.o",
        "usr/cpu/sysgen/IP27boot/gfxs.a",
        "usr/cpu/sysgen/IP27boot/gfxstubs.a",
        "usr/cpu/sysgen/IP27boot/rrm.o",
        "usr/cpu/sysgen/IP27boot/tport.a",
        "usr/cpu/sysgen/IP35boot/gfx.o",
        "usr/cpu/sysgen/IP35boot/gfxs.a",
        "usr/cpu/sysgen/IP35boot/gfxstubs.a",
        "usr/cpu/sysgen/IP35boot/rrm.o",
        "usr/cpu/sysgen/IP35boot/tport.a"
      ]
    },
    {
      "group": "kernel-config",
      "role": "shared-data",
      "paths": [
        "var/sysgen/system/gfx.sm",
        "var/sysgen/mtune/gfx",
        "var/sysgen/master.d/gfxs"
      ]
    },
    {
      "group": "libraries",
      "role": "board-library",
      "paths": [
        "usr/gfx/arch/IP27KONA",
        "usr/gfx/arch/IP27KONA32",
        "usr/gfx/arch/IP27KONA64",
        "usr/gfx/arch/IP35KONA",
        "usr/gfx/arch/IP35KONA32",
        "usr/gfx/arch/IP35KONA64"
      ]
    },
    {
      "group": "x-module",
      "role": "board-x-module",
      "paths": [
        "usr/lib/X11/dyDDX/kona.so",
        "usr/lib/X11/dyDDX/konad.so",
        "usr/lib/X11/dyDDX/konal.so",
        "usr/lib/X11/dyDDX/konas.so",
        "usr/lib/X11/dyDDX/konavis.so"
      ]
    },
    {
      "group": "x-shared",
      "role": "shared-x-server",
      "paths": [
        "usr/gfx/arch/GENERIC/Xsgi",
        "usr/lib/X11/dyDDX/glx.so"
      ]
    },
    {
      "group": "board-tools",
      "role": "board-tool",
      "paths": [
        "usr/gfx/KONA",
        "usr/gfx/ircombine",
        "usr/gfx/hyperpipeinfo",
        "usr/gfx/ucode/vfc/sdbutil"
      ]
    },
    {
      "group": "tools",
      "role": "shared-tool",
      "paths": [
        "usr/gfx/gfxinit",
        "usr/gfx/gfxinfo",
        "usr/gfx/gfxtopology",
        "usr/gfx/sgcombine",
        "usr/gfx/setmon",
        "usr/gfx/dmconf",
        "usr/gfx/startgfx",
        "usr/gfx/stopgfx",
        "usr/bin/X11/xsetmon"
      ]
    },
    {
      "group": "shared-libraries",
      "role": "shared-library",
      "paths": [
        "usr/gfx/arch/IGLOO/libgl.so",
        "usr/gfx/arch/IGLOO32/libgl.so",
        "usr/lib32/libfm.so"
      ]
    },
    {
      "group": "microcode",
      "role": "board-microcode",
      "paths": [
        "usr/gfx/ucode/KONA"
      ]
    },
    {
      "group": "video-formats",
      "role": "board-data",
      "paths": [
        "usr/gfx/ucode/vfc/rules/dg4.def",
        "usr/gfx/ucode/vfc/rules/dg4_ddo_gvo.def",
        "usr/gfx/ucode/vfc/rules/dplex.def",
        "usr/gfx/ucode/vfc/rules/voc1.def"
      ]
    },
    {
      "group": "diagnostics",
      "role": "board-diagnostic",
      "paths": [
        "usr/diags/IR"
      ]
    },
    {
      "group": "app-defaults",
      "role": "shared-data",
      "paths": [
        "usr/lib/X11/app-defaults/Ircombine",
        "usr/lib/X11/app-defaults/Dmconf",
        "usr/lib/X11/app-defaults/XSetmon"
      ]
    }
  ],
  "exclude": [],
  "windows": [
    {
      "name": "pipe",
      "size": "0x1000000",
      "regions": [
        {
          "name": "xg",
          "lo": "0x0",
          "hi": "0x800000",
          "docs": [
            "devices/xg/XG.h",
            "devices/xg/README.md",
            "devices/hip/README.md",
            "software/kernel/kernel.md"
          ]
        },
        {
          "name": "hip",
          "lo": "0x800000",
          "hi": "0xc00000",
          "docs": [
            "devices/hip/HIP.h",
            "devices/hip/README.md",
            "software/kernel/kernel.md",
            "devices/xg/README.md"
          ]
        },
        {
          "name": "hip-alias",
          "lo": "0xc00000",
          "hi": "0x1000000",
          "docs": [
            "devices/hip/HIP.h",
            "devices/hip/README.md",
            "software/kernel/kernel.md"
          ]
        }
      ]
    },
    {
      "name": "command-port",
      "size": "0x4",
      "docs": [
        "devices/ge/GE.h",
        "devices/hip/HIP.h",
        "software/kernel/kernel.md",
        "devices/hip/README.md",
        "kona_kernel/include/kona_kern.h"
      ]
    },
    {
      "name": "user-pipe",
      "size": "0x20c000",
      "regions": [
        {
          "name": "user-fifo",
          "lo": "0x0",
          "hi": "0x4000",
          "docs": [
            "devices/ge/GE.h",
            "devices/hip/HIP.h",
            "software/opengl/opengl.md",
            "software/kernel/kernel.md",
            "devices/hip/README.md"
          ]
        },
        {
          "name": "user-hip",
          "lo": "0x4000",
          "hi": "0x8000",
          "docs": [
            "devices/hip/HIP.h",
            "devices/hip/README.md",
            "software/kernel/kernel.md",
            "software/opengl/opengl.md"
          ]
        },
        {
          "name": "user-return",
          "lo": "0x8000",
          "hi": "0xc000",
          "docs": [
            "devices/hip/HIP.h",
            "devices/hip/README.md",
            "software/kernel/kernel.md",
            "software/opengl/opengl.md"
          ]
        },
        {
          "name": "user-io",
          "lo": "0xc000",
          "hi": "0x20c000",
          "docs": [
            "devices/hip/HIP.h",
            "devices/xg/XG.h",
            "devices/hip/README.md",
            "devices/xg/README.md",
            "software/kernel/kernel.md"
          ]
        }
      ]
    },
    {
      "name": "ge",
      "size": "0x100000",
      "docs": [
        "devices/ge/GE.h",
        "devices/ge/README.md",
        "ucode/ged.md"
      ]
    },
    {
      "name": "raster-index",
      "size": "0x100000",
      "docs": [
        "devices/rm/RM.h",
        "devices/rm/README.md"
      ]
    }
  ],
  "bases": [
    {
      "type": "field",
      "disp": 2376,
      "loads": [
        "ld"
      ],
      "window": "pipe",
      "label": "pipe state +0x948",
      "binaries": [
        "usr/cpu/sysgen/*/kona.a*"
      ],
      "why": "the per-pipe register base sits at pipe state +0x948 (software/kernel/kernel.md, Registers the driver touches)"
    },
    {
      "type": "field",
      "disp": 2304,
      "loads": [
        "ld"
      ],
      "window": "command-port",
      "label": "pipe state +0x900",
      "binaries": [
        "usr/cpu/sysgen/*/kona.a*"
      ],
      "why": "the address the kernel writes command words to sits at pipe state +0x900 (kona_kernel/include/kona_kern.h, KONA_SC_FIFO_PORT); which register window it points into is not settled"
    },
    {
      "type": "constant",
      "lo": "0x4000",
      "hi": "0x20c000",
      "window": "user-pipe",
      "label": "user pipe mapping",
      "binaries": [
        "usr/gfx/arch/IP*KONA*/*",
        "usr/lib/X11/dyDDX/kona*.so",
        "usr/gfx/KONA/*"
      ],
      "why": "libGLcore sends every command to process address 0x4000, the start of the per-thread pipe mapping (GE.h, KONA_USER_FIFO_VA; layout from software/kernel/kernel.md)"
    }
  ],
  "accessors": [
    {
      "function": "gfx_pio_read_32",
      "address_reg": 4,
      "access": "r",
      "width": 4,
      "binaries": [
        "usr/cpu/sysgen/*/kona.a*"
      ]
    },
    {
      "function": "gfx_pio_write_32",
      "address_reg": 4,
      "value_reg": 5,
      "access": "w",
      "width": 4,
      "binaries": [
        "usr/cpu/sysgen/*/kona.a*"
      ]
    }
  ],
  "tokens": {
    "value_width": 3,
    "name_prefixes": [
      "KONA_"
    ],
    "sources": [
      {
        "type": "table",
        "label": "kpm",
        "kind": "token",
        "file": "{tmp}/hp_commands.tsv",
        "columns": {
          "value": "token",
          "name": "name"
        }
      },
      {
        "type": "header",
        "label": "GE.h",
        "kind": "token",
        "file": "devices/ge/GE.h",
        "pattern": "^\\s*(KONA_HP_\\w+)\\s*=\\s*(0x[0-9a-fA-F]+)"
      },
      {
        "type": "table",
        "label": "firmware map",
        "kind": "token",
        "file": "{tmp}/icu_map.tsv",
        "columns": {
          "value": "token",
          "detail": {
            "route": "route",
            "arm_handler": "handler"
          }
        }
      },
      {
        "type": "stores",
        "label": "kernel command port",
        "kind": "token",
        "window": "command-port",
        "lo": "0x0",
        "hi": "0x4",
        "value_mask": "0xffff",
        "known_only": true,
        "first_store_only": true,
        "binaries": [
          "usr/cpu/sysgen/*/kona.a*"
        ]
      },
      {
        "type": "stores",
        "label": "user FIFO",
        "kind": "token",
        "window": "user-pipe",
        "lo": "0x0",
        "hi": "0x4000",
        "value_mask": "0xffff",
        "known_only": true,
        "first_store_only": true
      }
    ]
  },
  "ioctls": {
    "send_functions": [
      "ioctl",
      "__glKon_ioctl"
    ],
    "ranges": [
      [
        "100",
        "199"
      ],
      [
        "1000",
        "1999"
      ],
      [
        "10000",
        "10199"
      ]
    ],
    "min_decimal": 1000,
    "dispatchers": [
      {
        "type": "jump-table",
        "name": "kona private",
        "function": "KONAprivate",
        "binaries": [
          "usr/cpu/sysgen/*/kona.a*"
        ]
      }
    ],
    "classes": [
      {
        "lo": 10000,
        "hi": 10199,
        "name": "kona private"
      },
      {
        "lo": 1000,
        "hi": 1999,
        "name": "graphics manager"
      },
      {
        "lo": 100,
        "hi": 199,
        "name": "graphics init"
      }
    ],
    "docs": [
      "devices/*.md",
      "formats/*.md",
      "platforms/*.md",
      "software/*.md",
      "evidence/coverage.md",
      "evidence/hw-explanations-kona-p1.md",
      "evidence/instruction-readings-*.md",
      "evidence/tooling*.md",
      "evidence/routines/*.md",
      "questions/*.md",
      "references/*.md",
      "ucode/*.md"
    ]
  },
  "ucode": [
    {
      "type": "table",
      "program": "arm1.u",
      "kind": "symbol",
      "file": "{tmp}/arm1_symbols.tsv",
      "columns": {
        "address": "address",
        "name": "name",
        "detail": [
          "flags"
        ]
      },
      "kind_by_name": {
        "\\$\\$": "linker region"
      }
    },
    {
      "type": "table",
      "program": "arm1.u",
      "kind": "display command",
      "file": "ucode/dg_dispatch.tsv",
      "pointer": true,
      "columns": {
        "address": "command",
        "name": "handler",
        "detail": [
          "words"
        ]
      }
    },
    {
      "type": "symbols",
      "program": "ge.u",
      "kind": "label",
      "file": "root/usr/gfx/ucode/KONA/ge_symbols"
    },
    {
      "type": "u16-table",
      "program": "geif.u",
      "kind": "dispatch entry",
      "file": "root/usr/gfx/ucode/KONA/geif.u",
      "labels": "ge.u"
    },
    {
      "type": "table",
      "program": "ged1b.u",
      "kind": "table B entry",
      "file": "ucode/ged_banks.tsv",
      "pointer": true,
      "columns": {
        "address": "n",
        "detail": [
          "entry",
          "source",
          "line"
        ]
      }
    }
  ],
  "spec_registers": [
    {
      "type": "table",
      "spec": "kpm register tables",
      "table": "host interface",
      "file": "{tmp}/hip_registers.tsv",
      "where": {
        "kind": "1"
      },
      "where_not": {
        "offset": [
          "0xdead"
        ]
      },
      "columns": {
        "offset": "offset",
        "name": "name"
      },
      "window": "hip",
      "offset_bias": "0x800000",
      "width": 32
    },
    {
      "type": "table",
      "spec": "kpm register tables",
      "table": "geometry engine",
      "file": "{tmp}/ge_registers.tsv",
      "where": {
        "kind": "1"
      },
      "columns": {
        "offset": "address",
        "name": "name"
      },
      "window": "ge",
      "width": 32
    },
    {
      "type": "table",
      "spec": "kpm register tables",
      "table": "raster",
      "file": "{tmp}/raster_registers.tsv",
      "where": {
        "kind": "1"
      },
      "columns": {
        "offset": "value",
        "name": "name"
      },
      "window": "raster-index",
      "width": 32
    }
  ]
}
